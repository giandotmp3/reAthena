# rathena web-server environment (S1: no credential literals; values come from
# the environment or a secret store). Copy and fill in outside version control.

# Listener (conf/web_athena.conf web_port: 8888)
WEB_BIND=0.0.0.0
WEB_PORT=8888

# Database: WEB_DB_URL, falling back to DATABASE_URL. Never commit a real value.
WEB_DB_URL=${DATABASE_URL}

# Emblems (BR-WEB-005/006). Transparency limit in percent; 100 disables the check.
WEB_ALLOW_GIFS=yes
WEB_EMBLEM_TRANSPARENCY_LIMIT=80

# CORS (BR-WEB-016): exact origin, e.g. https://example.invalid:8080. Empty = off.
WEB_ALLOWED_ORIGIN_CORS=

# BR-WEB-011 SME question: verify that GID belongs to AID on char/merchant routes.
WEB_VERIFY_CHAR_OWNERSHIP=yes

# Dev only: run with an empty in-memory store (no DB).
# RATHENA_WEB_DEV_INMEMORY=1
