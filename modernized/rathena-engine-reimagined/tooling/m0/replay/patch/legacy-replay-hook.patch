+// Record/replay conformance hook for the legacy script VM (tooling/m0/replay).
+// NOT part of the legacy build: applied only to a COPY of the source tree by replay/build_legacy.sh.
+// Included at the very end of script.cpp so it can see the file-static VM state (str_data, buildin_func, st_db).
+//
+// Activation: environment variable RA_REPLAY_NPC=<npc name>. Nothing here runs without it.
+//   RA_REPLAY_NPC      unique NPC name (e.g. "Gatekeeper#1" or exname)
+//   RA_REPLAY_ANSWERS  file: one answer per line for menu/select/prompt (1-based, 0 = cancel, >n = last option)
+//                      and input/inputstr (number or text); exhausted -> select 1, input 1 / "test"
+//   RA_REPLAY_PLAYER   file: key=value (name, class, sex, baselevel, joblevel, zeny, group)
+//   RA_REPLAY_TRACE    output file (trace format: see replay/TRACE_FORMAT.md)
+//   RA_REPLAY_LABEL    optional entry label (default: script start)
+//   RA_REPLAY_DUMP_CONSTS  write every integer constant of the VM as name<TAB>value, then (without RA_REPLAY_NPC) do nothing else
+//   RA_REPLAY_CAP      max blocking interactions (default 60)
+//
+// The hook (1) runs the NPC script for a synthetic player exactly as npc_click() would
+// (run_script -> RERUNLINE/STOP/CLOSE continuations exactly as npc_scriptcont() does, minus the
+// client checks), and (2) records every buildin call from run_func() for that script only
+// (st->oid == the NPC, st->rid == the synthetic player): name, evaluated arguments, pushed return.
+
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <map>
+
+bool replay_active(){ return g_replay_on; }
+static int32 g_replay_oid = 0, g_replay_rid = 0, g_replay_root_id = 0;
+static FILE* g_replay_fp = nullptr;
+static uint64 g_replay_rand_n = 0;
+
+static std::string replay_fmt_str( const char* s ){
+	std::string o = "\"";
+	for( ; s != nullptr && *s; ++s ){
+		unsigned char c = (unsigned char)*s;
+		if( c == '\\' ) o += "\\\\";
+		else if( c == '"' ) o += "\\\"";
+		else if( c == '\n' ) o += "\\n";
+		else if( c == '\r' ) o += "\\r";
+		else if( c == '\t' ) o += "\\t";
+		else if( c < 0x20 || c == 0x7f ){ char b[8]; snprintf( b, sizeof(b), "\\x%02x", c ); o += b; }
+		else o += (char)c;
+	}
+	return o + "\"";
+}
+
+static std::string replay_lower( const char* s ){
+	std::string o( s );
+	for( char& c : o ) if( c >= 'A' && c <= 'Z' ) c = (char)( c - 'A' + 'a' );
+	return o;
+}
+
+// canonical variable reference name: lower-case, "[idx]" only for idx != 0
+static std::string replay_refname( const script_data* d ){
+	std::string n = replay_lower( reference_getname( d ) );
+	uint32 idx = reference_getindex( d );
+	if( idx != 0 ){ char b[24]; snprintf( b, sizeof(b), "[%u]", idx ); n += b; }
+	return n;
+}
+
+// Format one evaluated stack value. as_ref: the buildin's argument spec says 'r' (reference) -> keep the name.
+static std::string replay_fmt_data( struct script_state* st, const script_data* d0, bool as_ref ){
+	script_data d = *d0; // evaluate a copy: the VM's own get_val() later sees the untouched original
+	if( d.type == C_NAME && as_ref )
+		return "&" + replay_refname( &d );
+	if( d.type == C_POS || d.type == C_USERFUNC_POS )
+		return "@label";
+	if( d.type == C_NAME )
+		get_val( st, &d );
+	if( d.type == C_INT ){
+		char b[32]; snprintf( b, sizeof(b), "%lld", (long long)d.u.num ); return b;
+	}
+	if( d.type == C_STR || d.type == C_CONSTSTR )
+		return replay_fmt_str( d.u.str );
+	return "<type" + std::to_string( (int)d.type ) + ">";
+}
+
+static bool replay_skip_name( const std::string& n ){
+	static const char* skip[] = { "set", "setr", "jump_zero", "goto", "callsub", "callfunc", "return", "getarg", "getargcount", "end", "getelementofarray", "getd", "setd", nullptr };
+	for( int i = 0; skip[i]; i++ ) if( n == skip[i] ) return true;
+	return false;
+}
+
+// Returns true when this call must be recorded; fills `line` with "name(args)".
+static bool replay_pre( struct script_state* st, int32 func, std::string& line ){
+	if( st->oid != g_replay_oid || st->rid != g_replay_rid ) return false;
+	if( g_replay_root_id == 0 ) g_replay_root_id = st->id;
+	if( st->id != g_replay_root_id ) return false; // other scripts of the same NPC (events) are not part of the trace
+	std::string name = replay_lower( get_str( func ) );
+	if( replay_skip_name( name ) ) return false;
+	const char* spec = buildin_func[str_data[func].val].arg;
+	size_t speclen = spec ? strlen( spec ) : 0;
+	line = name + "(";
+	int32 last = script_lastdata( st );
+	if( name == "menu" ){ // label form: record only the visible option texts, labels dropped
+		bool first = true;
+		for( int32 i = 2; i < last; i += 2 ){
+			script_data d = st->stack->stack_data[st->start + i]; get_val( st, &d );
+			if( d.type != C_STR && d.type != C_CONSTSTR ) continue;
+			std::string s = d.u.str; size_t p = 0;
+			for( ;; ){
+				size_t q = s.find( ':', p );
+				std::string piece = s.substr( p, q == std::string::npos ? std::string::npos : q - p );
+				if( !piece.empty() ){ if( !first ) line += ","; first = false; line += replay_fmt_str( piece.c_str() ); }
+				if( q == std::string::npos ) break;
+				p = q + 1;
+			}
+		}
+		line += ")";
+		return true;
+	}
+	for( int32 i = 2; i <= last; i++ ){
+		char t = 0;
+		size_t k = (size_t)( i - 2 );
+		if( k < speclen && spec[k] != '?' && spec[k] != '*' ) t = spec[k];
+		else {
+			size_t j = std::min( k, speclen ); // marker or past the end: the nearest typed char before it
+			while( j > 0 && ( spec[j-1] == '?' || spec[j-1] == '*' ) ) j--;
+			t = j > 0 ? spec[j-1] : 0;
+		}
+		if( i > 2 ) line += ",";
+		line += replay_fmt_data( st, &st->stack->stack_data[st->start + i], t == 'r' );
+	}
+	line += ")";
+	return true;
+}
+
+static void replay_post( struct script_state* st, int32 func, int32 rc, const std::string& line ){
+	if( st->state == RERUNLINE ) return; // blocked: recorded when it completes (re-run)
+	std::string name = replay_lower( get_str( func ) );
+	std::string out = line;
+	if( st->stack->sp > st->end ){
+		script_data* top = &st->stack->stack_data[st->stack->sp - 1];
+		if( name == "rand" && top->type == C_INT ){ // scripted RNG: identical sequence on both sides
+			int64 a = 0, b = 0; int32 n = st->end - st->start - 2;
+			script_data d0 = st->stack->stack_data[st->start + 2]; get_val( st, &d0 ); a = d0.u.num;
+			if( n >= 2 ){ script_data d1 = st->stack->stack_data[st->start + 3]; get_val( st, &d1 ); b = d1.u.num; }
+			uint64 r = ( 1103515245ULL * ( ++g_replay_rand_n ) + 12345ULL ) % 2147483648ULL;
+			int64 v;
+			if( n >= 2 ){ if( b < a ) std::swap( a, b ); v = a + (int64)( r % (uint64)( b - a + 1 ) ); }
+			else v = a <= 0 ? 0 : (int64)( r % (uint64)a );
+			top->u.num = v;
+		}
+		if( ( name == "gettime" || name == "gettimetick" ) && top->type == C_INT ){ // scripted clock: 2026-10-18 12:34:56 UTC, a Sunday
+			script_data d0 = st->stack->stack_data[st->start + 2]; get_val( st, &d0 );
+			static const int64 gt[] = { -1, 56, 34, 12, 0, 18, 10, 2026, 291 };
+			if( name == "gettime" ) top->u.num = ( d0.u.num >= 1 && d0.u.num <= 8 ) ? gt[d0.u.num] : -1;
+			else top->u.num = d0.u.num == 0 ? 1000000 : d0.u.num == 1 ? 1792326896 : d0.u.num == 2 ? 45296 : 0;
+		}
+		out += " -> " + replay_fmt_data( st, top, false );
+	}
+	if( rc == SCRIPT_CMD_FAILURE ) out += " !F";
+	if( g_replay_fp ) fprintf( g_replay_fp, "%s\n", out.c_str() );
+}
+
+// ---- end-of-run state dump ---------------------------------------------------------------------
+typedef std::map<std::string,std::string> replay_snap;
+static void replay_dump_regs( replay_snap& out, const char* tag, DBMap* vars, int kind /* 0 char regs, 1 npc-local, 2 mapreg */ ){
+	if( vars == nullptr ) return;
+	DBIterator* it = db_iterator( vars );
+	DBKey key;
+	for( DBData* d = it->first( it, &key ); dbi_exists( it ); d = it->next( it, &key ) ){
+		int64 uid = key.i64;
+		const char* name = get_str( script_getvarid( uid ) );
+		uint32 idx = script_getvaridx( uid );
+		std::string nm = replay_lower( name );
+		if( idx != 0 ){ char b[24]; snprintf( b, sizeof(b), "[%u]", idx ); nm += b; }
+		std::string val;
+		bool isstr = name[strlen( name ) - 1] == '$';
+		if( kind == 2 ){
+			mapreg_save* m = (mapreg_save*)db_data2ptr( d );
+			if( m == nullptr ) continue;
+			if( m->is_string ) val = replay_fmt_str( m->u.str ); else { char b[32]; snprintf( b, sizeof(b), "%lld", (long long)m->u.i ); val = b; }
+		}else{
+			char p0 = name[0];
+			bool raw = kind == 1 || p0 == '.' || p0 == '\'' || ( p0 == '@' && !isstr ); // stored as plain int64 / char*
+			if( isstr ){
+				const char* s = raw ? (const char*)db_data2ptr( d ) : ( (script_reg_str*)db_data2ptr( d ) )->value;
+				val = replay_fmt_str( s ? s : "" );
+			}else{
+				long long v = raw ? (long long)db_data2i64( d ) : (long long)( (script_reg_num*)db_data2ptr( d ) )->value;
+				char b[32]; snprintf( b, sizeof(b), "%lld", v ); val = b;
+			}
+		}
+		out[std::string( tag ) + nm] = val;
+	}
+	dbi_destroy( it );
+}
+
+static replay_snap replay_snapshot( map_session_data* sd, npc_data* nd ){
+	replay_snap m;
+	replay_dump_regs( m, "", sd->regs.vars, 0 );        // character / account / temp ('@') variables
+	replay_dump_regs( m, "", regs.vars, 2 );             // '$' and '$@'
+	if( nd->u.scr.script ) replay_dump_regs( m, "", nd->u.scr.script->local.vars, 1 ); // '.' variables of this NPC
+	return m;
+}
+
+static std::string replay_getenv( const char* k ){ const char* v = getenv( k ); return v ? v : ""; }
+
+static std::vector<std::string> replay_read_lines( const std::string& path ){
+	std::vector<std::string> v;
+	if( path.empty() ) return v;
+	FILE* f = fopen( path.c_str(), "rb" );
+	if( !f ) return v;
+	char buf[4096];
+	while( fgets( buf, sizeof(buf), f ) ){
+		std::string s = buf;
+		while( !s.empty() && ( s.back() == '\n' || s.back() == '\r' ) ) s.pop_back();
+		v.push_back( s );
+	}
+	fclose( f );
+	return v;
+}
+
+// Called from map.cpp right after ScriptHost::run_oninit().
+void replay_main(){
+	std::string dump = replay_getenv( "RA_REPLAY_DUMP_CONSTS" );
+	if( !dump.empty() ){ // all integer constants of the VM (script constants + hardcoded ones), for the Luau side
+		FILE* f = fopen( dump.c_str(), "wb" );
+		if( f ){
+			for( int32 i = LABEL_START; i < str_num; i++ )
+				if( str_data[i].type == C_INT ) fprintf( f, "%s\t%lld\n", get_str( i ), (long long)str_data[i].val );
+			fclose( f );
+		}
+	}
+	std::string npcname = replay_getenv( "RA_REPLAY_NPC" );
+	if( npcname.empty() ) return;
+	std::string tracepath = replay_getenv( "RA_REPLAY_TRACE" );
+	g_replay_fp = fopen( tracepath.c_str(), "wb" );
+	if( !g_replay_fp ){ ShowError( "replay: cannot open trace file '%s'\n", tracepath.c_str() ); return; }
+	npc_data* nd = npc_name2id( npcname.c_str() );
+	if( nd == nullptr || nd->subtype != NPCTYPE_SCRIPT ){
+		fprintf( g_replay_fp, "#end npc-not-found\n" ); fclose( g_replay_fp ); g_replay_fp = nullptr; return;
+	}
+	std::vector<std::string> answers = replay_read_lines( replay_getenv( "RA_REPLAY_ANSWERS" ) );
+	size_t ai = 0;
+	auto next_answer = [&]( std::string& out ) -> bool {
+		while( ai < answers.size() ){
+			std::string s = answers[ai++];
+			if( s.empty() || s[0] == '#' ) continue;
+			out = s; return true;
+		}
+		return false;
+	};
+	int32 cap = atoi( replay_getenv( "RA_REPLAY_CAP" ).c_str() ); if( cap <= 0 ) cap = 60;
+
+	// ---- the synthetic player ----------------------------------------------------------------
+	map_session_data* sd;
+	CREATE( sd, map_session_data, 1 );
+	new( sd ) map_session_data();
+	sd->fd = 0;
+	if( session_isValid( 0 ) ) session[0]->flag.eof = 1; // clif_* helpers treat fd 0 as disconnected: nothing is sent
+	sd->type = BL_PC; sd->id = 150000;
+	int16 pm = nd->m >= 0 ? nd->m : map_mapname2mapid( "prontera" ); // floating NPCs ('-') have no map
+	sd->m = pm; sd->x = nd->m >= 0 ? nd->x : 150; sd->y = nd->m >= 0 ? nd->y : 150;
+	sd->mapindex = map_getmapdata( pm )->index;
+	sd->state.active = 1;
+	sd->status.account_id = 2000000; sd->status.char_id = 150000;
+	safestrncpy( sd->status.name, "Tester", sizeof( sd->status.name ) );
+	sd->status.sex = SEX_MALE; sd->status.base_level = 1; sd->status.job_level = 1; sd->status.zeny = 0;
+	sd->weight = 0; sd->max_weight = 20000;
+	sd->inventory.max_amount = MAX_INVENTORY; sd->inventory.type = TABLE_INVENTORY;
+	sd->vars_ok = true;
+	sd->regs.vars = i64db_alloc( DB_OPT_BASE ); sd->regs.arrays = nullptr; // as pc_authok() does
+	sd->group_id = 0;
+	sd->status.inventory_slots = INVENTORY_BASE_SIZE;
+	for( const std::string& l : replay_read_lines( replay_getenv( "RA_REPLAY_PLAYER" ) ) ){
+		size_t eq = l.find( '=' ); if( eq == std::string::npos || l[0] == '#' ) continue;
+		std::string k = l.substr( 0, eq ), v = l.substr( eq + 1 );
+		if( k == "name" ) safestrncpy( sd->status.name, v.c_str(), sizeof( sd->status.name ) );
+		else if( k == "class" ) sd->status.class_ = atoi( v.c_str() );
+		else if( k == "sex" ) sd->status.sex = atoi( v.c_str() ) ? SEX_MALE : SEX_FEMALE;
+		else if( k == "baselevel" ) sd->status.base_level = atoi( v.c_str() );
+		else if( k == "joblevel" ) sd->status.job_level = atoi( v.c_str() );
+		else if( k == "zeny" ) sd->status.zeny = atoi( v.c_str() );
+		else if( k == "group" ) sd->group_id = atoi( v.c_str() );
+	}
+	pc_group_pc_load( sd ); // sd->group from sd->group_id (getgmlevel & co)
+	map_addiddb( sd );
+
+	replay_snap before = replay_snapshot( sd, nd );
+	{ // start state of the run ('$', '$@' and this NPC's '.' variables, as left by the server's OnInit run), for seeding the Luau side
+		FILE* fi = fopen( ( tracepath + ".init" ).c_str(), "wb" );
+		if( fi ){ for( auto& kv : before ) fprintf( fi, "%s\t%s\n", kv.first.c_str(), kv.second.c_str() ); fclose( fi ); }
+	}
+	g_replay_oid = nd->id; g_replay_rid = sd->id; g_replay_root_id = 0; g_replay_on = true;
+
+	std::string reason = "end";
+	int32 inter = 0;
+	int32 startpos = 0;
+	std::string label = replay_getenv( "RA_REPLAY_LABEL" );
+	if( !label.empty() ){
+		startpos = -1;
+		for( int32 i = 0; i < nd->u.scr.label_list_num; i++ )
+			if( !strcasecmp( nd->u.scr.label_list[i].name, label.c_str() ) ){ startpos = nd->u.scr.label_list[i].pos; break; }
+		if( startpos < 0 ){ g_replay_on = false; fprintf( g_replay_fp, "#end label-not-found\n" ); fclose( g_replay_fp ); g_replay_fp = nullptr; return; }
+	}
+	run_script( nd->u.scr.script, startpos, sd->id, nd->id );
+	while( g_replay_root_id != 0 && ( idb_get( st_db, g_replay_root_id ) != nullptr ) ){
+		script_state* st = (script_state*)idb_get( st_db, g_replay_root_id );
+		if( ++inter > cap ){ reason = "cap"; break; }
+		if( st->sleep.timer != INVALID_TIMER ){ // sleep: fire the timer body synchronously
+			run_script_timer( st->sleep.timer, gettick(), st->sleep.charid, (intptr_t)st );
+			continue;
+		}
+		if( st->state == CLOSE ){ st->state = END; run_script_main( st ); continue; }
+		if( st->state == STOP ){ st->state = RUN; run_script_main( st ); continue; }
+		if( st->state == RERUNLINE ){
+			std::string fn = replay_lower( st->funcname ? st->funcname : "" );
+			std::string a;
+			bool have = next_answer( a );
+			if( fn == "select" || fn == "menu" || fn == "prompt" ){
+				int32 n = sd->npc_menu, pick = have ? atoi( a.c_str() ) : 1;
+				if( pick <= 0 ) sd->npc_menu = 0xff; // cancel
+				else sd->npc_menu = std::min( pick, n );
+			}else if( fn == "input" ){
+				script_data* v = &st->stack->stack_data[st->start + 2];
+				if( is_string_variable( reference_getname( v ) ) ){
+					safestrncpy( sd->npc_str, have ? a.c_str() : "test", sizeof( sd->npc_str ) );
+				}else sd->npc_amount = have ? atoi( a.c_str() ) : 1;
+			}else{ reason = "blocked:" + fn; break; }
+			run_script_main( st );
+			continue;
+		}
+		reason = "state:" + std::to_string( (int)st->state ); break;
+	}
+	if( reason == "end" && g_replay_root_id != 0 && ( idb_get( st_db, g_replay_root_id ) != nullptr ) ) reason = "alive";
+	g_replay_on = false;
+
+	// ---- final state -------------------------------------------------------------------------------
+	std::vector<std::string> state;
+	{
+		replay_snap after = replay_snapshot( sd, nd );
+		for( auto& kv : after ){ auto it = before.find( kv.first ); if( it == before.end() || it->second != kv.second ) state.push_back( "=" + kv.first + "=" + kv.second ); }
+		for( auto& kv : before ) if( after.find( kv.first ) == after.end() ) state.push_back( "=" + kv.first + "=<unset>" );
+	}
+	const struct { const char* n; int64 v; } params[] = {
+		{ "zeny", sd->status.zeny }, { "baselevel", sd->status.base_level }, { "joblevel", sd->status.job_level },
+		{ "class", sd->status.class_ }, { "statuspoint", sd->status.status_point }, { "skillpoint", sd->status.skill_point },
+		{ "baseexp", (int64)sd->status.base_exp }, { "jobexp", (int64)sd->status.job_exp }, { "karma", sd->status.karma }, { "manner", sd->status.manner },
+	};
+	for( auto& p : params ) if( p.v != 0 ) state.push_back( std::string( "%" ) + p.n + "=" + std::to_string( (long long)p.v ) );
+	for( int i = 0; i < MAX_INVENTORY; i++ )
+		if( sd->inventory.u.items_inventory[i].nameid && sd->inventory.u.items_inventory[i].amount )
+			state.push_back( "+item " + std::to_string( (unsigned long long)sd->inventory.u.items_inventory[i].nameid ) + "=" + std::to_string( sd->inventory.u.items_inventory[i].amount ) );
+	std::sort( state.begin(), state.end() );
+	fprintf( g_replay_fp, "#end %s\n", reason.c_str() );
+	for( const std::string& s : state ) fprintf( g_replay_fp, "%s\n", s.c_str() );
+	fclose( g_replay_fp ); g_replay_fp = nullptr;
+}
