set_budget(0.5)
local t = clock()
local ok, err = pcall(function() local i = 0 while true do i = i + 1 end end)
print(string.format("runaway while-true: %s after %.3f s", ok and "NOT stopped" or "stopped: " .. tostring(err), clock() - t))
set_budget(0.5)
local t = clock()
local ok, err = pcall(function() return string.find(string.rep("a", 30), string.rep("a?", 30) .. string.rep("a", 30)) end)
print(string.format("pathological pattern (native call): %s after %.3f s", ok and "completed" or "stopped: " .. tostring(err), clock() - t))
set_budget(0.5)
local t = clock()
local ok, err = pcall(function() local x = {} for i = 1, 3e6 do x[i] = i end table.sort(x, function(a, b) return a > b end) end)
print(string.format("table.sort 3e6 with comparator: %s after %.3f s", ok and "completed" or "stopped: " .. tostring(err), clock() - t))
